# V1-059 (DL-071 answer 8; DEPLOY-051): health checks and Telegram alerts. Started every 5 minutes.
[Unit]
Description=CHETANA Residence Management operations check

[Service]
Type=oneshot
User=prm-ops
Group=prm-ops
UMask=0077
ExecStart=/opt/prm/venv/bin/property-rental-ops-check --config /etc/prm/production-operations.json run
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prm/status
PrivateTmp=true
# The secret files live in /etc/prm/secrets (kept across restarts); the job sees them at
# /run/secrets, the paths of production-operations.json.
BindReadOnlyPaths=/etc/prm/secrets:/run/secrets
