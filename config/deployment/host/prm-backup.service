# V1-059 (DL-071 answers 1 to 5): one encrypted backup, then retention. Started by prm-backup.timer.
[Unit]
Description=CHETANA Residence Management hourly backup
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=prm-ops
Group=prm-ops
UMask=0077
ExecStart=/opt/prm/venv/bin/property-rental-backup --config /etc/prm/production-operations.json --pg-bin /usr/lib/postgresql/17/bin run
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prm
PrivateTmp=true
# The secret files live in /etc/prm/secrets (kept across restarts); the job sees them at
# /run/secrets, the paths of production-operations.json.
BindReadOnlyPaths=/etc/prm/secrets:/run/secrets
